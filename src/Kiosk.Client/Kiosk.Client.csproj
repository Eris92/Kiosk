<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- Windows Hello through the WinRT ABI (WindowsHello.cs) instead of the 24 MB Windows SDK projection. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- No NuGet API documentation (*.xml) in the package. -->
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <!-- Line numbers in logged errors without a separate Kiosk.Client.pdb. -->
    <DebugType>embedded</DebugType>
    <!-- Local dotnet build is framework-dependent; scripts\Build.ps1 publishes the client self-contained. -->
    <SelfContained>false</SelfContained>
    <!-- DOTNET_STARTUP_HOOKS cannot load foreign code into the Kiosk (the service trusts the installed Kiosk program). -->
    <StartupHookSupport>false</StartupHookSupport>
    <!-- Designer serialization of public control properties: these controls are built in code, never in the designer. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Every screen at its own scale (125 %, 100 %…): screen windows fill the screen, hosted programs are not stretched. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
  <PropertyGroup Condition="'$(KioskSelfTest)' == 'true'">
    <DefineConstants>$(DefineConstants);KIOSK_SELF_TEST</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>
  <!-- Example company messages (Konfiguracja → Komunikaty → "Użyj przykładu"), installed and updated with the program. -->
  <ItemGroup>
    <None Include="..\..\config\news\**\*" LinkBase="news-example" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- WebView2 adds its WPF assembly too; this application only uses WinForms. -->
  <Target Name="RemoveUnusedWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
</Project>
